# Copy this file to ".env" (same folder) and fill in what you have.
# Everything is optional: the app runs with no keys at all.

# --- Optional AI (any OpenAI-compatible chat API) -------------------------
# With no key, IntentLock reads invoices with built-in rules instead of an LLM.
# Examples of base URLs (check your provider's docs for current model names):
#   Groq:      https://api.groq.com/openai/v1
#   Qwen:      https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   OpenAI:    https://api.openai.com/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# Set to 1 only if your model accepts images (lets you upload photos of invoices)
LLM_VISION=0

# --- Optional blockchain access -------------------------------------------
# Free TronGrid works without a key at low volume. A key avoids rate limits.
TRONGRID_API_KEY=
# TRON_API_URL=https://api.trongrid.io
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com
